// Copy this file to Secrets.xcconfig and fill in local values.
// The $() keeps // from being parsed as a comment in xcconfig files.
BASE_URL = https:/$()/example.com
API_KEY =
KAKAO_NATIVE_APP_KEY =

// 포트원 가맹점 식별코드(imp_xxxxxxxx). 결제 SDK 호출에만 사용되며, 비어 있으면 결제 화면에서만 차단된다.
IMP_USER_CODE =
// 포트원 PG 코드 예시: html5_inicis.MOIxxxxxxx, kakaopay.TC0ONETIME, tosspayments.testtoss
IMP_PG =
